From 0029b45013a4245371b48bac27b0917900368a81 Mon Sep 17 00:00:00 2001
From: palazik <gochmyradov0@gmail.com>
Date: Mon, 19 Oct 2026 23:20:19 +0500
Subject: [PATCH] dodge: boot-CPU driver (DodgeCPU, single-core IOCPU bring-up)

Port of dipa-studio/ios-sweet 0018. DodgeCPU : IOCPU matched via IONameMatch
'qcom,oryon' (our ADT cpu nodes); registers the boot CPU with ml_processor_register
+ processor_start, self-tests the Group-1 SGI1 IPI path (signalCPU -> ICC_SGI1R_EL1
-> sleh_irq -> cpu_signal_handler) before completing init. Single-CPU only
(secondary startup / suspend panic until SMP+PSCI). Uses DODGE_IPI_SGI; cpuName
'Oryon'. Pairs with patch 0013's Group-1 IRQ path.

Co-Authored-By: Claude Opus 4.8 <noreply@anthropic.com>
---
 iokit/Kernel/arm/DodgeCPU.cpp | 171 ++++++++++++++++++++++++++++++++++
 iokit/KernelConfigTables.cpp  |   6 ++
 iokit/conf/files.arm64        |   2 +
 3 files changed, 179 insertions(+)
 create mode 100644 iokit/Kernel/arm/DodgeCPU.cpp

diff --git a/iokit/Kernel/arm/DodgeCPU.cpp b/iokit/Kernel/arm/DodgeCPU.cpp
new file mode 100644
index 0000000..54d58ad
--- /dev/null
+++ b/iokit/Kernel/arm/DodgeCPU.cpp
@@ -0,0 +1,171 @@
+/*
+ * Single-CPU bring-up for dodge using XNU's legacy IOCPU interface.
+ * The architected timer and SGI1 already enter through pe_fiq/sleh_irq.
+ * Secondary CPU startup and system suspend require separate platform work.
+ */
+#include <pexpert/arm64/board_config.h>
+
+#if defined(DODGE)
+#include <IOKit/IOCPU.h>
+#include <IOKit/IOLib.h>
+#include <libkern/c++/OSData.h>
+#include <libkern/c++/OSNumber.h>
+#include <arm64/proc_reg.h>
+#include <machine/atomic.h>
+#include <kern/clock.h>
+#include <kern/processor.h>
+#include <mach/mach_time.h>
+
+class DodgeCPU : public IOCPU {
+	OSDeclareDefaultStructors(DodgeCPU);
+	const OSSymbol *cpuName = NULL;
+
+public:
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+	void free(void) APPLE_KEXT_OVERRIDE;
+	void initCPU(bool boot) APPLE_KEXT_OVERRIDE;
+	void quiesceCPU(void) APPLE_KEXT_OVERRIDE;
+	kern_return_t startCPU(vm_offset_t start_paddr, vm_offset_t arg_paddr) APPLE_KEXT_OVERRIDE;
+	void haltCPU(void) APPLE_KEXT_OVERRIDE;
+	void signalCPU(IOCPU *target) APPLE_KEXT_OVERRIDE;
+	const OSSymbol *getCPUName(void) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(DodgeCPU, IOCPU);
+
+bool
+DodgeCPU::start(IOService *provider)
+{
+	const ml_topology_info_t *topology = ml_get_topology_info();
+	const ml_topology_cpu_t *cpu = topology->boot_cpu;
+	OSNumber *logical = OSDynamicCast(OSNumber, provider->getProperty("logical-cpu-id"));
+	OSData *reg = OSDynamicCast(OSData, provider->getProperty("reg"));
+
+	if (logical == NULL || reg == NULL || reg->getLength() != sizeof(uint32_t) ||
+	    logical->unsigned32BitValue() != cpu->cpu_id ||
+	    *(const uint32_t *)reg->getBytesNoCopy() != cpu->phys_id) {
+		return false;
+	}
+	if (topology->num_cpus != 1) {
+		panic("DODGE CPU: only single-CPU bring-up is supported");
+	}
+	if (!IOCPU::start(provider)) {
+		return false;
+	}
+	cpuName = OSSymbol::withCStringNoCopy("Oryon");
+	if (cpuName == NULL) {
+		return false;
+	}
+	setCPUNumber(cpu->cpu_id);
+
+	ml_processor_info_t info = {};
+	info.cpu_id = reinterpret_cast<cpu_id_t>(this);
+	info.phys_id = cpu->phys_id;
+	info.log_id = cpu->cpu_id;
+	info.cluster_id = cpu->cluster_id;
+	info.cluster_type = cpu->cluster_type;
+	info.l2_cache_id = cpu->l2_cache_id;
+	info.l2_cache_size = cpu->l2_cache_size;
+	info.l3_cache_id = cpu->l3_cache_id;
+	info.l3_cache_size = cpu->l3_cache_size;
+	perfmon_interrupt_handler_func pmi_handler = NULL;
+	kern_return_t result = ml_processor_register(&info, &machProcessor, &ipi_handler, &pmi_handler);
+	if (result != KERN_SUCCESS) {
+		panic("DODGE CPU: ml_processor_register failed: %d", result);
+	}
+	if (pmi_handler != NULL) {
+		panic("DODGE CPU: PMI routing is not implemented");
+	}
+
+	/* Re-enter the boot CPU through cpu_machine_init -> PE_cpu_machine_init. */
+	result = processor_start(machProcessor);
+	if (result != KERN_SUCCESS || getCPUState() != kIOCPUStateRunning) {
+		panic("DODGE CPU: processor_start failed: %d", result);
+	}
+	ml_cpu_init_completed();
+	cpusRunning();
+	registerService();
+	IOService::publishResource(gIOAllCPUInitializedKey, kOSBooleanTrue);
+
+	/* Announce completion only after registration, startup and SGI validation. */
+	ml_set_max_cpus(topology->max_cpu_id + 1);
+	IOLog("DODGE CPU: boot CPU %u registered, SGI1 verified, initialization complete\n",
+	    getCPUNumber());
+	return true;
+}
+
+void
+DodgeCPU::free(void)
+{
+	OSSafeReleaseNULL(cpuName);
+	IOCPU::free();
+}
+
+void
+DodgeCPU::initCPU(bool boot)
+{
+	if (!boot) {
+		panic("DODGE CPU: resume is not implemented");
+	}
+	assert(cpu_number() == (int)getCPUNumber());
+	assert(ml_get_interrupts_enabled());
+	ml_broadcast_cpu_event(CPU_BOOTED, getCPUNumber());
+
+	/* A real GIC interrupt clears SIGPdisabled in cpu_signal_handler. */
+	uint64_t deadline;
+	nanoseconds_to_deadline(NSEC_PER_SEC, &deadline);
+	signalCPU(this);
+	while (!ml_cpu_signal_is_enabled()) {
+		if (mach_absolute_time() > deadline) {
+			panic("DODGE CPU: SGI1 self-test timed out");
+		}
+		__asm__ volatile("yield");
+	}
+	setCPUState(kIOCPUStateRunning);
+}
+
+void
+DodgeCPU::signalCPU(IOCPU *target)
+{
+	/* Only the boot CPU is registered by this driver. */
+	if (target != this || cpu_number() != (int)getCPUNumber()) {
+		panic("DODGE CPU: secondary CPU signalling is not implemented");
+	}
+	uint64_t mpidr = __builtin_arm_rsr64("MPIDR_EL1");
+	unsigned int aff0 = mpidr & 0xff;
+	if (aff0 >= 16) {
+		panic("DODGE CPU: SGI target requires unsupported range selector");
+	}
+	uint64_t sgi = (((mpidr >> 32) & 0xff) << 48) |
+	    (((mpidr >> 16) & 0xff) << 32) |
+	    (((mpidr >> 8) & 0xff) << 16) |
+	    ((uint64_t)DODGE_IPI_SGI << 24) | (1ULL << aff0);
+	__builtin_arm_dsb(DSB_ISHST);
+	__builtin_arm_wsr64("ICC_SGI1R_EL1", sgi);
+	__builtin_arm_isb(ISB_SY);
+}
+
+kern_return_t
+DodgeCPU::startCPU(vm_offset_t start_paddr __unused, vm_offset_t arg_paddr __unused)
+{
+	return KERN_NOT_SUPPORTED;
+}
+
+void
+DodgeCPU::quiesceCPU(void)
+{
+	panic("DODGE CPU: CPU quiesce is not implemented");
+}
+
+void
+DodgeCPU::haltCPU(void)
+{
+	panic("DODGE CPU: CPU halt/suspend is not implemented");
+}
+
+const OSSymbol *
+DodgeCPU::getCPUName(void)
+{
+	return cpuName;
+}
+#endif /* DODGE */
diff --git a/iokit/KernelConfigTables.cpp b/iokit/KernelConfigTables.cpp
index ad77a71..e1e872c 100644
--- a/iokit/KernelConfigTables.cpp
+++ b/iokit/KernelConfigTables.cpp
@@ -41,6 +41,12 @@ const char * gIOKernelConfigTables =
     "     'IONameMatch'     = 'oneplus,dodge';"
     "     'IOProbeScore'    = 10000:32;"
     "   },"
+    "   {"
+    "     'IOClass'         = DodgeCPU;"
+    "     'IOProviderClass' = IOPlatformDevice;"
+    "     'IONameMatch'     = 'qcom,oryon';"
+    "     'IOProbeScore'    = 10000:32;"
+    "   },"
 #endif
     "   {"
     "     'IOClass'         = IOPanicPlatform;"
diff --git a/iokit/conf/files.arm64 b/iokit/conf/files.arm64
index ac1846a..ea7b6c5 100644
--- a/iokit/conf/files.arm64
+++ b/iokit/conf/files.arm64
@@ -8,3 +8,5 @@ iokit/Kernel/arm/AppleARMSMP.cpp    					optional iokitcpp
 
 # DODGE device-tree platform (empty translation unit on other boards)
 iokit/Kernel/arm/DodgePlatformExpert.cpp                         optional iokitcpp
+
+iokit/Kernel/arm/DodgeCPU.cpp                                    optional iokitcpp
