 osfmk/arm64/arm64_hypercall.c	standard
 osfmk/arm/io_map.c		standard
 osfmk/arm64/loose_ends.c	standard
diff --git a/osfmk/kern/debug.c b/osfmk/kern/debug.c
index 0a00656..a9493ea 100644
--- a/osfmk/kern/debug.c
+++ b/osfmk/kern/debug.c
@@ -84,6 +84,9 @@
 #include <stdatomic.h>
 #include <sys/pgo.h>
 #include <console/serial_protos.h>
+#if defined(__arm64__)
+#include <arm64/dodge_early.h>
+#endif
 #include <IOKit/IOBSD.h>
 
 #if !(MACH_KDP && CONFIG_KDP_INTERACTIVE_DEBUGGING)
@@ -1069,6 +1072,11 @@ panic_trap_to_debugger(const char *panic_format_str, va_list *panic_args, unsign
 {
 #pragma clang diagnostic pop
 
+#if defined(DODGE)
+	/* No CPU/thread/debugger state is required for this first panic copy. */
+	dodge_early_panic(panic_format_str, panic_args);
+#endif
+
 #if defined(__x86_64__) && (DEVELOPMENT || DEBUG)
 	read_lbr();
 #endif
