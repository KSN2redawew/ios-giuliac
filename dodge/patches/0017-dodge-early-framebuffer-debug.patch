@@ -423,6 +427,7 @@ arm_init(
 #endif
 
 	ml_parse_cpu_topology();
+	dodge_early_mark(3, "ml_parse_cpu_topology done");
 
 
 	master_cpu = ml_get_boot_cpu_number();
@@ -453,11 +458,13 @@ arm_init(
 	 */
 	thread->machine.preemption_count = 0;
 	cpu_bootstrap();
+	dodge_early_mark(4, "cpu_bootstrap done");
 
 	rtclock_early_init();
 
 	kernel_debug_string_early("kernel_startup_bootstrap");
 	kernel_startup_bootstrap();
+	dodge_early_mark(5, "kernel_startup_bootstrap done");
 
 	/*
 	 * Initialize the timer callout world
@@ -466,6 +473,7 @@ arm_init(
 
 	cpu_init();
 
+	dodge_early_mark(6, "cpu_init done");
 	processor_bootstrap();
 
 	if (PE_parse_boot_argn("maxmem", &maxmem, sizeof(maxmem))) {
@@ -513,6 +521,7 @@ arm_init(
 	__builtin_arm_wsr("pan", 1);
 #endif  /* __ARM_PAN_AVAILABLE__ */
 
+	dodge_early_mark(7, "entering arm_vm_init");
 	arm_vm_init(xmaxmem, args);
 
 	if (debug_boot_arg) {
diff --git a/osfmk/arm64/arm_vm_init.c b/osfmk/arm64/arm_vm_init.c
index 7210a0a..32499bd 100644
--- a/osfmk/arm64/arm_vm_init.c
+++ b/osfmk/arm64/arm_vm_init.c
@@ -41,6 +41,7 @@
 #include <machine/atomic.h>
 #include <arm64/proc_reg.h>
 #include <arm64/lowglobals.h>
+#include <arm64/dodge_early.h>
 #include <arm/cpu_data_internal.h>
 #include <arm/misc_protos.h>
 #include <pexpert/arm64/boot.h>
@@ -2157,6 +2158,8 @@ arm_vm_init(uint64_t memory_size, boot_args * args)
 
