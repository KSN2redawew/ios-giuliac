diff --git a/osfmk/arm64/dodge_early.c b/osfmk/arm64/dodge_early.c
new file mode 100644
index 0000000..d31253d
--- /dev/null
+++ b/osfmk/arm64/dodge_early.c
@@ -0,0 +1,130 @@
+/*
+ * Redmi Note 10 Pro bootstrap console. No allocation, locks, ADT parsing or
+ * per-CPU state: panic() can reach this before a current thread exists.
+ * start.s maps the splash framebuffer VA=PA as Normal Non-Cacheable memory.
+ * Stop using that mapping before arm_vm_init tears down bootstrap TTBR0.
+ */
+#include <arm64/dodge_early.h>
+
+#if defined(DODGE)
+#include <stdint.h>
+#include <kern/misc_protos.h>
+
+#define EARLY_FB ((volatile uint32_t *)(uintptr_t)0xd5100000)
+#define EARLY_WIDTH 1264u
+#define EARLY_HEIGHT 2780u
+#define EARLY_STRIDE (5056u / 4)
+#define EARLY_SCALE 2u
+#define EARLY_CELL_W (8u * EARLY_SCALE)
+#define EARLY_CELL_H (16u * EARLY_SCALE)
+#define EARLY_ROWS ((EARLY_HEIGHT - 32u) / EARLY_CELL_H)
+#define EARLY_COLS (EARLY_WIDTH / EARLY_CELL_W)
+
+extern unsigned char iso_font[256 * 16];
+
+/* Initialized data must remain writable until disable, including panics. */
+static unsigned int early_row, early_col;
+static unsigned int early_started, early_disabled, early_panicking;
+
+static void
+dodge_early_clear_row(void)
+{
+	for (unsigned int y = 0; y < EARLY_CELL_H; y++) {
+		volatile uint32_t *line = EARLY_FB + (early_row * EARLY_CELL_H + y) * EARLY_STRIDE;
+		for (unsigned int x = 0; x < EARLY_WIDTH; x++) {
+			line[x] = 0xff000000u;
+		}
+	}
+}
+
+void
+dodge_early_putc(char c)
+{
+	if (early_disabled) {
+		return;
+	}
+	if (!early_started) {
+		early_started = 1;
+		dodge_early_clear_row();
+	}
+	if (c == '\r') {
+		early_col = 0;
+		return;
+	}
+	if (c == '\n' || early_col == EARLY_COLS) {
+		early_col = 0;
+		early_row = (early_row + 1) % EARLY_ROWS;
+		dodge_early_clear_row();
+		if (c == '\n') {
+			return;
+		}
+	}
+	const unsigned char *glyph = iso_font + (unsigned char)c * 16;
+	for (unsigned int gy = 0; gy < 16; gy++) {
+		for (unsigned int sy = 0; sy < EARLY_SCALE; sy++) {
+			volatile uint32_t *line = EARLY_FB +
+			    (early_row * EARLY_CELL_H + gy * EARLY_SCALE + sy) * EARLY_STRIDE +
+			    early_col * EARLY_CELL_W;
+			for (unsigned int gx = 0; gx < 8; gx++) {
+				uint32_t pixel = (glyph[gy] & (1u << gx)) ? 0xffffffffu : 0xff000000u;
+				for (unsigned int sx = 0; sx < EARLY_SCALE; sx++) {
+					line[gx * EARLY_SCALE + sx] = pixel;
+				}
+			}
+		}
+	}
+	early_col++;
+}
+
+static void
+dodge_early_string(const char *s)
+{
+	while (*s) {
+		dodge_early_putc(*s++);
+	}
+}
+
+void
+dodge_early_mark(unsigned int stage, const char *label)
+{
+	if (early_disabled || stage > 8) {
+		return;
+	}
+	uint32_t color = 0xff00ff00u | (stage * 28u << 16);
+	for (unsigned int y = EARLY_HEIGHT - 32; y < EARLY_HEIGHT; y++) {
+		for (unsigned int x = stage * 64; x < (stage + 1) * 64; x++) {
+			EARLY_FB[y * EARLY_STRIDE + x] = color;
+		}
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+	dodge_early_string("DODGE EARLY ");
+	dodge_early_putc((char)('0' + stage));
+	dodge_early_string(": ");
+	dodge_early_string(label);
+	dodge_early_putc('\n');
+}
+
+void
+dodge_early_panic(const char *fmt, va_list *args)
+{
+	if (early_disabled || early_panicking) {
+		return;
+	}
+	early_panicking = 1;
+	dodge_early_string("\nDODGE EARLY PANIC: ");
+	va_list copy;
+	va_copy(copy, *args);
+	_doprnt(fmt, &copy, dodge_early_putc, 16);
+	va_end(copy);
+	dodge_early_putc('\n');
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
+void
+dodge_early_disable(void)
+{
+	dodge_early_mark(8, "leaving bootstrap TTBR0");
+	early_disabled = 1;
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+#endif /* DODGE */
diff --git a/osfmk/arm64/dodge_early.h b/osfmk/arm64/dodge_early.h
new file mode 100644
index 0000000..478a472
--- /dev/null
+++ b/osfmk/arm64/dodge_early.h
@@ -0,0 +1,22 @@
+/* Early screen diagnostics, valid only while the bootstrap TTBR0 is live. */
+#ifndef _ARM64_DODGE_EARLY_H_
+#define _ARM64_DODGE_EARLY_H_
+
+#include <pexpert/arm64/board_config.h>
+#include <stdarg.h>
+
+#if defined(DODGE)
+void dodge_early_mark(unsigned int stage, const char *label);
+void dodge_early_putc(char c);
+void dodge_early_panic(const char *fmt, va_list *args);
+void dodge_early_disable(void);
+#else
+static inline void dodge_early_mark(unsigned int stage, const char *label)
+{
+	(void)stage;
+	(void)label;
+}
+static inline void dodge_early_disable(void) {}
+#endif
+
+#endif
diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
index c33d316..46cf455 100644
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -463,6 +463,25 @@ LEXT(start_first_cpu)
 	mov		x20, x0
 	mov		x21, #0
 
+#if defined(DODGE)
+	/* Stage 0: white 64x32 band, no stack or page tables needed. */
+	MOV64	x0, (0xd5100000 + 2748 * 5056)
+	mov		w1, #-1
+	mov		x2, #32
+	mov		x4, #5056
+Ldodge_mark_row:
+	mov		x3, #64
+	mov		x5, x0
+Ldodge_mark_pixel:
+	str		w1, [x5], #4
+	subs	x3, x3, #1
+	b.ne	Ldodge_mark_pixel
+	add		x0, x0, x4
+	subs	x2, x2, #1
+	b.ne	Ldodge_mark_row
+	dsb		sy
+#endif
+
 	// Set low reset vector before attempting any loads
 	adrp	x0, EXT(LowExceptionVectorBase)@page
 	add		x0, x0, EXT(LowExceptionVectorBase)@pageoff
@@ -609,6 +628,23 @@ Lkernelcache_base_found:
 	lsr		x5,  x24, #(ARM_TT_L2_SHIFT)
 	create_bootstrap_mapping x14, x15, x5, x3, x2, x9, x10, x11, x12, x13
 
+#if defined(DODGE)
+	/*
+	 * Splash framebuffer: one 32MB Normal-NC block in the EXISTING V=P
+	 * L2 table. Both framebuffer and RAM use L1 index 0; another call to
+	 * create_bootstrap_mapping would replace the RAM L2 table.
+	 * DODGE uses 16K pages and all bring-up RAM is below 4GB, so the first
+	 * V=P L2 page is bootstrap_pagetables + 2*PGBYTES.
+	 */
+	MOV64	x10, 0xd5100000
+	MOV64	x11, (ARM_TTE_TYPE_BLOCK | ARM_TTE_VALID | ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) | ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB) | ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX)
+	orr		x11, x11, x10
+	and		x12, x10, #(ARM_TT_L2_INDEX_MASK)
+	lsr		x12, x12, #(ARM_TT_L2_SHIFT)
+	add		x13, x25, #(2 * PGBYTES)
+	str		x11, [x13, x12, lsl #TTE_SHIFT]
+#endif
+
 	/* Ensure TTEs are visible */
 	dsb		ish
 
diff --git a/osfmk/conf/files.arm64 b/osfmk/conf/files.arm64
index c40d57b..2745cc1 100644
--- a/osfmk/conf/files.arm64
+++ b/osfmk/conf/files.arm64
