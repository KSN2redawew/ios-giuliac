From 0bbd6d850794ce17c6bf2091e4c28bfce3836b78 Mon Sep 17 00:00:00 2001
From: palazik <gochmyradov0@gmail.com>
Date: Tue, 20 Oct 2026 21:02:02 +0500
Subject: [PATCH 21/23] dodge: use the built-in SHA-256 in libkern's digest API

Port of dipa-studio/ios-sweet 0023 (credit: dipa-studio).

libkern's SHA256_* route through g_crypto_funcs, which only the corecrypto
kext fills in; without it the first code-signing page hash dereferences
NULL. XNU already carries ccsha256_ltc_di in osfmk/corecrypto (the PRNG
uses it), so point SHA256_* straight at it. SHA-384/512 have no built-in
provider and are left alone.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
---
 libkern/crypto/corecrypto_sha2.c | 26 +++++++++++++++++++++-----
 1 file changed, 21 insertions(+), 5 deletions(-)

diff --git a/libkern/crypto/corecrypto_sha2.c b/libkern/crypto/corecrypto_sha2.c
index 7392f0c..45be625 100644
--- a/libkern/crypto/corecrypto_sha2.c
+++ b/libkern/crypto/corecrypto_sha2.c
@@ -34,34 +34,50 @@
 
 #if defined(CRYPTO_SHA2)
 
+#if defined(ARM64_BOARD_CONFIG_DODGE)
+/*
+ * dodge has no corecrypto kext, so g_crypto_funcs stays NULL. SHA-256 uses
+ * XNU's built-in implementation directly, as the dodge PRNG does; this also
+ * serves code-signing page hashes. SHA-384/512 have no built-in provider.
+ */
+#include <corecrypto/ccsha2.h>
+#define SHA256_DI()                     (&ccsha256_ltc_di)
+#define SHA256_INIT(di, ctx)            ccdigest_init(di, ctx)
+#define SHA256_UPDATE(di, ctx, len, d)  ccdigest_update(di, ctx, len, d)
+#else
+#define SHA256_DI()                     (g_crypto_funcs->ccsha256_di)
+#define SHA256_INIT(di, ctx)            g_crypto_funcs->ccdigest_init_fn(di, ctx)
+#define SHA256_UPDATE(di, ctx, len, d)  g_crypto_funcs->ccdigest_update_fn(di, ctx, len, d)
+#endif
+
 void
 SHA256_Init(SHA256_CTX *ctx)
 {
 	const struct ccdigest_info *di;
-	di = g_crypto_funcs->ccsha256_di;
+	di = SHA256_DI();
 
 	/* Make sure the context size for the digest info fits in the one we have */
 	if (ccdigest_di_size(di) > sizeof(SHA256_CTX)) {
 		panic("%s: inconsistent size for SHA256 context", __FUNCTION__);
 	}
 
-	g_crypto_funcs->ccdigest_init_fn(di, ctx->ctx);
+	SHA256_INIT(di, ctx->ctx);
 }
 
 void
 SHA256_Update(SHA256_CTX *ctx, const void *data, size_t len)
 {
 	const struct ccdigest_info *di;
-	di = g_crypto_funcs->ccsha256_di;
+	di = SHA256_DI();
 
-	g_crypto_funcs->ccdigest_update_fn(di, ctx->ctx, len, data);
+	SHA256_UPDATE(di, ctx->ctx, len, data);
 }
 
 void
 SHA256_Final(void *digest, SHA256_CTX *ctx)
 {
 	const struct ccdigest_info *di;
-	di = g_crypto_funcs->ccsha256_di;
+	di = SHA256_DI();
 
 	ccdigest_final(di, ctx->ctx, digest);
 }
