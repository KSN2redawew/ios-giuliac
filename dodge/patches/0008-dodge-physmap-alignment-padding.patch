From 6e6546e176737c4fdb763fa159e5c47ba7f0dbda Mon Sep 17 00:00:00 2001
From: palazik <gochmyradov0@gmail.com>
Date: Mon, 19 Oct 2026 22:41:12 +0500
Subject: [PATCH] dodge: physmap alignment padding for the NO_MONITOR
 large-memory aperture

Port of dipa-studio/ios-sweet 0011. arm_vm_physmap_slide() preserves each PA's
block offset, so each PTOV entry can consume one extra twig of VA; reserve
ARM64_PHYSMAP_ALIGNMENT_PADDING (PTOV_TABLE_SIZE * ARM_TT_TWIG_SIZE) in both the
physmap L1 allocation and the aperture end for the NO_MONITOR + ARM_LARGE_MEMORY
kernel (0 under XNU_MONITOR).

Co-Authored-By: Claude Opus 4.8 <noreply@anthropic.com>
---
 osfmk/arm64/arm_vm_init.c | 20 ++++++++++++++++----
 1 file changed, 16 insertions(+), 4 deletions(-)

diff --git a/osfmk/arm64/arm_vm_init.c b/osfmk/arm64/arm_vm_init.c
index d89b0f1..7210a0a 100644
--- a/osfmk/arm64/arm_vm_init.c
+++ b/osfmk/arm64/arm_vm_init.c
@@ -1812,6 +1812,18 @@ init_ptpages(tt_entry_t *tt, vm_map_address_t start, vm_map_address_t end, bool
 #define ARM64_PHYSMAP_SLIDE_RANGE (1ULL << 30) // 1 GB
 #define ARM64_PHYSMAP_SLIDE_MASK  (ARM64_PHYSMAP_SLIDE_RANGE - 1)
 
+#if XNU_MONITOR
+#define ARM64_PHYSMAP_ALIGNMENT_PADDING 0ULL
+#else
+/*
+ * arm_vm_physmap_slide() preserves each PA's block offset, so each PTOV entry
+ * can consume up to one extra twig of VA space. Reserve that space in both the
+ * aperture bound and its L1 allocation, including the ARM_LARGE_MEMORY config
+ * dodge's non-PPL (NO_MONITOR) kernel uses.
+ */
+#define ARM64_PHYSMAP_ALIGNMENT_PADDING (PTOV_TABLE_SIZE * ARM_TT_TWIG_SIZE)
+#endif
+
 void
 arm_vm_init(uint64_t memory_size, boot_args * args)
 {
@@ -1859,7 +1871,7 @@ arm_vm_init(uint64_t memory_size, boot_args * args)
 	}
 
 #if defined(ARM_LARGE_MEMORY)
-	unsigned long physmap_l1_entries = ((real_phys_size + ARM64_PHYSMAP_SLIDE_RANGE) >> ARM_TT_L1_SHIFT) + 1;
+	unsigned long physmap_l1_entries = ((real_phys_size + ARM64_PHYSMAP_SLIDE_RANGE + ARM64_PHYSMAP_ALIGNMENT_PADDING) >> ARM_TT_L1_SHIFT) + 1;
 	physmap_base = VM_MIN_KERNEL_ADDRESS - (physmap_l1_entries << ARM_TT_L1_SHIFT);
 #else
 	physmap_base = phystokv(args->topOfKernelData);
@@ -1883,10 +1895,10 @@ arm_vm_init(uint64_t memory_size, boot_args * args)
 #if defined(ARM_LARGE_MEMORY)
 	/* For large memory systems with no PPL such as virtual machines */
 	static_memory_end = phystokv(args->topOfKernelData);
-	physmap_end = physmap_base + real_phys_size;
+	physmap_end = physmap_base + real_phys_size + ARM64_PHYSMAP_ALIGNMENT_PADDING;
 #else
-	static_memory_end = physmap_base + mem_size + (PTOV_TABLE_SIZE * ARM_TT_TWIG_SIZE); // worst possible case for block alignment
-	physmap_end = physmap_base + real_phys_size + (PTOV_TABLE_SIZE * ARM_TT_TWIG_SIZE);
+	static_memory_end = physmap_base + mem_size + ARM64_PHYSMAP_ALIGNMENT_PADDING; // worst possible case for block alignment
+	physmap_end = physmap_base + real_phys_size + ARM64_PHYSMAP_ALIGNMENT_PADDING;
 #endif // ARM_LARGE_MEMORY
 #endif
 
