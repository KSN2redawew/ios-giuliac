From f0237ddb06180b176dff4688950b1b30b5d2cf2d Mon Sep 17 00:00:00 2001
From: palazik <gochmyradov0@gmail.com>
Date: Tue, 20 Oct 2026 21:01:31 +0500
Subject: [PATCH 20/23] dodge: mockfs RAM-disk root without IOStorageFamily

Port of dipa-studio/ios-sweet 0021, 0022 and 0024 (credit: dipa-studio).

Build mockfs into the kernel so a RAM disk can be the root volume before
any real storage stack exists, and let IOKit survive having no
IOStorageFamily at all: without the IOMedia and IOBlockStorageDriver
metaclasses there is no media to unhide and no block driver to find, so
assert() would fire on every boot. The root is simply not block media,
exactly as for image boot.

Two mockfs bugs upstream hits on the way:
  - kalloc_type(mockfs_fsnode_t) sized the allocation after the POINTER
    typedef (8 bytes), not the node; use struct mockfs_fsnode.
  - a virtual memory device (IOKit's RAMDisk) has no physical address for
    the pager to map, and mi_base is a 4K page number regardless of the
    kernel's 16K PAGE_SHIFT. Only treat mi_phys devices as memory backed,
    and shift by 12.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
---
 bsd/miscfs/mockfs/mockfs_fsnode.c |  7 ++++---
 bsd/miscfs/mockfs/mockfs_vfsops.c |  7 ++++++-
 config/MASTER.arm64.dodge         |  2 +-
 iokit/Kernel/IOService.cpp        | 19 +++++++++++++++++++
 4 files changed, 30 insertions(+), 5 deletions(-)

diff --git a/bsd/miscfs/mockfs/mockfs_fsnode.c b/bsd/miscfs/mockfs/mockfs_fsnode.c
index e000126..55c851c 100644
--- a/bsd/miscfs/mockfs/mockfs_fsnode.c
+++ b/bsd/miscfs/mockfs/mockfs_fsnode.c
@@ -85,7 +85,7 @@ mockfs_fsnode_create(mount_t mp, uint8_t type, mockfs_fsnode_t * fsnpp)
 		goto done;
 	}
 
-	*fsnpp = kalloc_type(mockfs_fsnode_t, Z_WAITOK | Z_ZERO | Z_NOFAIL);
+	*fsnpp = kalloc_type(struct mockfs_fsnode, Z_WAITOK | Z_ZERO | Z_NOFAIL);
 	(*fsnpp)->size = new_size;
 	(*fsnpp)->type = type;
 	(*fsnpp)->mnt = mp;
@@ -154,7 +154,7 @@ mockfs_fsnode_destroy(mockfs_fsnode_t fsnp)
 		}
 	}
 
-	kfree_type(mockfs_fsnode_t, fsnp);
+	kfree_type(struct mockfs_fsnode, fsnp);
 done:
 	return rvalue;
 }
@@ -345,7 +345,8 @@ mockfs_fsnode_vnode(mockfs_fsnode_t fsnp, vnode_t * vpp)
 				panic("mockfs_fsvnode failed to get ubc_mem_object for a new vnode");
 			}
 
-			rvalue = pager_map_to_phys_contiguous(ubc_mem_object, 0, (mockfs_mnt->mockfs_memdev_base << PAGE_SHIFT), fsnp->size);
+			/* memdev counts in 4K pages, independent of the kernel's PAGE_SHIFT. */
+			rvalue = pager_map_to_phys_contiguous(ubc_mem_object, 0, ((uint64_t)mockfs_mnt->mockfs_memdev_base << 12), fsnp->size);
 
 			if (rvalue) {
 				panic("mockfs_fsnode_vnode failed to create fictitious pages for a memory-backed device; rvalue = %d", rvalue);
diff --git a/bsd/miscfs/mockfs/mockfs_vfsops.c b/bsd/miscfs/mockfs/mockfs_vfsops.c
index 325bb06..9b8429b 100644
--- a/bsd/miscfs/mockfs/mockfs_vfsops.c
+++ b/bsd/miscfs/mockfs/mockfs_vfsops.c
@@ -102,7 +102,12 @@ mockfs_mountroot(mount_t mp, vnode_t rvp, __unused vfs_context_t ctx)
 		 * For the moment, we won't try to optimize when mi_phys is true.
 		 */
 		if (!mockfs_mount_data->mockfs_physical_memory) {
-			mockfs_mount_data->mockfs_memory_backed = memdev_info.mi_mdev;
+			/*
+			 * Only a physical memory device has an address the pager can map
+			 * directly; a virtual one (IOKit's RAMDisk) goes through normal
+			 * device I/O. mi_base is a physical page number only when mi_phys.
+			 */
+			mockfs_mount_data->mockfs_memory_backed = memdev_info.mi_mdev && memdev_info.mi_phys;
 			mockfs_mount_data->mockfs_physical_memory = memdev_info.mi_phys;
 			mockfs_mount_data->mockfs_memdev_base = memdev_info.mi_base;
 			mockfs_mount_data->mockfs_memdev_size = memdev_info.mi_size;
diff --git a/config/MASTER.arm64.dodge b/config/MASTER.arm64.dodge
index f3ba5bf..2bbdea0 100644
--- a/config/MASTER.arm64.dodge
+++ b/config/MASTER.arm64.dodge
@@ -24,7 +24,7 @@
 #  BSD_RELEASE =    [ BSD_BASE ]
 #  BSD_DEV =        [ BSD_BASE config_vnguard ]
 #  BSD_DEBUG =      [ BSD_BASE config_vnguard ]
-#  FILESYS_BASE =   [ devfs fdesc fifo fs_compression config_protect config_mnt_rootsnap config_rosv_startup config_mount_vm config_mount_prebootrecovery config_basesystemroot config_fse quota namedstreams config_imgsrc_access config_triggers config_ext_resolver config_searchfs config_volfs config_appledouble nullfs config_mnt_suid config_firmlinks config_dataless_files config_union_mounts config_file_leases ]
+#  FILESYS_BASE =   [ devfs fdesc fifo mockfs fs_compression config_protect config_mnt_rootsnap config_rosv_startup config_mount_vm config_mount_prebootrecovery config_basesystemroot config_fse quota namedstreams config_imgsrc_access config_triggers config_ext_resolver config_searchfs config_volfs config_appledouble nullfs config_mnt_suid config_firmlinks config_dataless_files config_union_mounts config_file_leases ]
 #  FILESYS_RELEASE= [ FILESYS_BASE ]
 #  FILESYS_DEV =    [ FILESYS_BASE config_iocount_trace ]
 #  FILESYS_DEBUG =  [ FILESYS_BASE config_iocount_trace ]
diff --git a/iokit/Kernel/IOService.cpp b/iokit/Kernel/IOService.cpp
index 8559a66..1ece374 100644
--- a/iokit/Kernel/IOService.cpp
+++ b/iokit/Kernel/IOService.cpp
@@ -5126,7 +5126,9 @@ IOService::publishHiddenMedia(IOService * parent)
 	bool                wasHiding;
 
 	iomediaClass = OSMetaClass::getMetaClassWithName(gIOMediaKey);
+#if !defined(ARM64_BOARD_CONFIG_DODGE)
 	assert(iomediaClass);
+#endif
 
 	LOCKWRITENOTIFY();
 	wasHiding = gIOServiceHideIOMedia;
@@ -5135,6 +5137,13 @@ IOService::publishHiddenMedia(IOService * parent)
 	}
 	UNLOCKNOTIFY();
 
+#if defined(ARM64_BOARD_CONFIG_DODGE)
+	/* dodge has no IOStorageFamily: without the IOMedia class no media exists to unhide. */
+	if (!iomediaClass) {
+		wasHiding = false;
+	}
+#endif
+
 	FindRootMediaContext ctx = { .services = NULL, .parent = parent };
 
 	if (wasHiding) {
@@ -5179,7 +5188,17 @@ IOService::setRootMedia(IOService * root)
 	bool unhide;
 
 	ioblockstoragedriverClass = OSMetaClass::getMetaClassWithName(gIOBlockStorageDriverKey);
+#if defined(ARM64_BOARD_CONFIG_DODGE)
+	/*
+	 * dodge has no IOStorageFamily, so no service can be a block storage
+	 * driver: the root (e.g. a RAM disk) is not block media, as for image boot.
+	 */
+	if (!ioblockstoragedriverClass) {
+		root = NULL;
+	}
+#else
 	assert(ioblockstoragedriverClass);
+#endif
 
 	while (root) {
 		if (root->metaCast(ioblockstoragedriverClass)) {
